          "name": "Submitting a new Batch",
          "request": {
            "name": "Submitting a new Batch",
            "description": {
              "content": "Submit a batch of SERP jobs to be fetched asynchronously. Results are POSTed back to webhook_url when the batch completes; polling by id is possible but the webhook notification system is recommended by Zenserp.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobs\": [\n    {\n      \"type\": \"search\",\n      \"custom_id\": \"<string>\",\n      \"q\": \"<string>\",\n      \"gl\": \"<string>\",\n      \"hl\": \"<string>\",\n      \"location\": \"<string>\",\n      \"num\": \"<integer>\",\n      \"start\": \"<integer>\",\n      \"tbm\": \"<string>\",\n      \"device\": \"<string>\",\n      \"search_engine\": \"<string>\"\n    }\n  ],\n  \"webhook_url\": \"<uri>\",\n  \"name\": \"<string>\"\n}",
