          "request": {
            "name": "Google Shopping Product Page",
            "description": {
              "content": "This endpoint gives you access to shopping product pages by their product_id or gpc_id, which can be obtained from a shopping search. Pass product_id to get a single product variant, or gpc_id (Google Product Cluster ID) to get the full product cluster across all merchants.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shopping"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "product_id",
                  "value": "<string>",
                  "description": "Google Shopping product id -- returns a single product variant."
                },
                {
                  "disabled": false,
                  "key": "gpc_id",
                  "value": "<string>",
                  "description": "Google Product Cluster ID -- returns the full product cluster across all merchants."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Canonical geo location string (see the /api/v2/locations list endpoint)."
                },
                {
                  "disabled": false,
                  "key": "search_engine",
                  "value": "<string>",
                  "description": "Google domain to query, e.g. google.com."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "<string>",
                  "description": "Interface language code."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "<string>",
                  "description": "Country code."
                }
              ],
              "variable": []
